# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL — application uses the asyncpg driver.
# Hosted providers often inject postgres://; the app normalizes that automatically.
DATABASE_URL=postgresql+asyncpg://clinic:clinic@localhost:5433/clinic

# Set true for hosts that require TLS (Render, some Railway/GCP setups).
DATABASE_SSL=false
# Render's internal Postgres cert is self-signed. Leave false unless you have a CA.
DATABASE_SSL_VERIFY=false

# Clinic local timezone. Working hours and calendar dates are interpreted here.
# Instants are stored in UTC.
CLINIC_TIMEZONE=Africa/Nairobi

# Booking rules (lead time is the bonus "no booking within 1 hour" rule).
MIN_BOOKING_NOTICE_MINUTES=60
MAX_BOOKING_AHEAD_DAYS=90

# Seed 5 doctors and 5 patients on startup. Set false in a real production cutover.
SEED_SAMPLE_DATA=true

# CORS: comma-separated origins, or * for any origin (acceptable for this public demo API).
CORS_ORIGINS=*
